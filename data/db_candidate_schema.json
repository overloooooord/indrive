{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InVision U — DB / Telegram Bot Candidate Record",
  "description": "Format produced by the Telegram bot and stored in the database. Transformed into ML pipeline format in data/loader.py before scoring.",
  "type": "object",
  "required": ["user_id", "personal", "education"],
  "properties": {

    "user_id":     { "type": "integer", "description": "Telegram user ID" },
    "username":    { "type": ["string", "null"], "description": "Telegram username" },
    "submitted_at":{ "type": ["string", "null"], "format": "date-time" },

    "personal": {
      "type": "object",
      "required": ["name", "age"],
      "properties": {
        "name":   { "type": "string" },
        "age":    { "type": "integer", "minimum": 14, "maximum": 25 },
        "city":   { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "school_type": {
          "type": ["string", "null"],
          "enum": ["general", "lyceum", "gymnasium", "specialized", "homeschool", "college", "other", null]
        },
        "languages": {
          "description": "Self-reported. Shown on commission card only, never scored.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "education": {
      "type": "object",
      "required": ["gpa"],
      "properties": {
        "gpa": {
          "type": ["number", "string"],
          "description": "GPA — may arrive as string (e.g. '5'), normalized to float in loader."
        },
        "ent_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 140,
          "description": "null if candidate did not take ENT."
        },
        "ielts_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 9.0,
          "description": "null if candidate has no IELTS."
        },
        "olympiads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subject", "level", "year"],
            "properties": {
              "subject": { "type": "string" },
              "level": {
                "type": "string",
                "enum": ["school", "city", "regional", "republican", "national", "international"]
              },
              "year":  { "type": "integer" },
              "prize": { "type": "boolean" }
            }
          }
        },
        "courses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "platform", "completed"],
            "properties": {
              "name":      { "type": "string" },
              "platform":  { "type": "string" },
              "year":      { "type": ["integer", "null"] },
              "completed": { "type": "boolean" }
            }
          }
        }
      }
    },

    "experience": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "role", "year"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["technical", "social", "media", "business", "education", "other"]
              },
              "role": {
                "type": "string",
                "enum": ["founder", "co_founder", "participant", "volunteer"]
              },
              "year":                    { "type": "integer" },
              "team_size":               { "type": ["integer", "null"], "minimum": 1 },
              "description":             { "type": ["string", "null"] },
              "failure_note":            { "type": ["string", "null"] },
              "continued_after_failure": { "type": ["boolean", "null"] }
            }
          }
        }
      }
    },

    "essay": {
      "type": ["object", "null"],
      "properties": {
        "text":       { "type": ["string", "null"] },
        "word_count": { "type": ["integer", "null"] }
      }
    },

    "scenario_results": {
      "type": "object",
      "description": "Raw choices from the bot. 'T' = timer expired (treated as non-compliant step). Bot must call compute_fingerprint() and store results before submitting.",
      "properties": {
        "choices": {
          "type": "array",
          "items": { "type": "string", "enum": ["A", "B", "C", "D", "T"] },
          "minItems": 10,
          "maxItems": 10
        }
      }
    },

    "fingerprint_display": {
      "type": ["object", "null"],
      "description": "5 SLPI cluster averages. Computed by bot via scenario_engine.compute_fingerprint(). null if fingerprint_reliable=false.",
      "properties": {
        "model":     { "type": "number" },
        "inspire":   { "type": "number" },
        "challenge": { "type": "number" },
        "enable":    { "type": "number" },
        "encourage": { "type": "number" }
      }
    },
    "fingerprint_reliable": { "type": "boolean" },
    "timer_violations":     { "type": "integer", "minimum": 0 },

    "uploaded_files": {
      "type": "array",
      "description": "Telegram file_ids for certificates. Shown to commission only.",
      "items": {
        "type": "object",
        "properties": {
          "type":        { "type": "string", "enum": ["ent_certificate", "ielts_certificate", "other"] },
          "file_id":     { "type": "string" },
          "uploaded_at": { "type": "string", "format": "date-time" }
        }
      }
    },

    "label": {
      "type": "string",
      "enum": ["shortlist", "maybe", "reject"],
      "description": "Human annotation — only present in training dataset, never in production."
    }
  }
}
