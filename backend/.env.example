# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — fallback to SQLite if not set
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — разрешить конкретные origins или включить * для разработки
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_IDS=chat_id_1,chat_id_2

# Admin panel
PANEL_USERNAME=admin
# Генерация: python -c "import bcrypt; print(bcrypt.hashpw(b'your_pass', bcrypt.gensalt()).decode())"
PANEL_PASSWORD_HASH=$2b$12$EXAMPLE_HASH_HERE

# Учителя — JSON вида: {"teacher1": {"name": "Елена", "password_hash": "..."}}
TEACHERS_JSON={}
